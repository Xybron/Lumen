# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
backend/dist/
frontend/dist/
media-sidecar/dist/
*.tsbuildinfo

# Desktop downloads, native staging and installers (application sources stay tracked)
desktop/.cache/
desktop/release/
desktop/test-results/

# Tauri / Rust build output + bundled sidecar binaries
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/

# Vite cache
.vite/
**/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*
.wrangler/
infra/powersync/.runtime/
supabase/.temp/
.local-projects/
.team-local/
.mobile-local/

# OS / editor
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Coverage / test artifacts
coverage/
.nyc_output/

# Lumen runtime data — keep folder shells via .gitkeep files
# but ignore everything generated or uploaded at runtime.
*.lumen

# SQLite identity/ops store (users, sessions, roles) — local runtime state
data/lumen.db
data/lumen.db-wal
data/lumen.db-shm
data/.lumen-runtime.lock
data/.lumen-runtime.lock.*.tmp
data/.lumen-runtime.lease.sqlite*
data/production.json
data/workspace.json
data/workspace.json.*.tmp
data/recordings/
data/clips/
data/broadcast/
data/outputs/
watch-relay/data/
watch-relay/tenants.json
data/worship.db*
data/ai/
agent/dist/

# Quarantined phone/contributor uploads awaiting approval
data/media/incoming/*
!data/media/incoming/.gitkeep

# Atomic-write rolling backups produced by backend/atomic.ts
data/backups/*
!data/backups/.gitkeep

# Server-generated thumbnails (sharp / fluent-ffmpeg)
data/media/thumbnails/*
!data/media/thumbnails/.gitkeep

# User-uploaded audio — don't commit large binaries
data/media/music/*
!data/media/music/.gitkeep
