# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
backend/dist/
frontend/dist/
*.tsbuildinfo

# Vite cache
.vite/
**/.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Coverage / test artifacts
coverage/
.nyc_output/

# Lumen runtime data — keep folder shells via .gitkeep files
# but ignore everything generated or uploaded at runtime.

# Atomic-write rolling backups produced by backend/atomic.ts
data/backups/*
!data/backups/.gitkeep

# Server-generated thumbnails (sharp / fluent-ffmpeg)
data/media/thumbnails/*
!data/media/thumbnails/.gitkeep

# User-uploaded audio — don't commit large binaries
data/media/music/*
!data/media/music/.gitkeep
