-- Inspect the role's SELECT-only grants and the exact four-table `powersync`
-- publication. Do not grant access to auth.*, lumen_private.*, secret/runtime
-- tables, writes, table ownership or future tables through default privileges.
-- Only after review, explicitly enable the role:
--   alter role lumen_sync_replica login;
