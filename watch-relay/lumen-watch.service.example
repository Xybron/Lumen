[Unit]
Description=Lumen independent public watch relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumen-watch
Group=lumen-watch
WorkingDirectory=/opt/lumen-watch
EnvironmentFile=/etc/lumen-watch.env
ExecStart=/usr/bin/node /opt/lumen-watch/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lumen-watch
UMask=0077

[Install]
WantedBy=multi-user.target
