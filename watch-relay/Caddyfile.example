# Point this host's DNS to the VPS before starting Caddy. Caddy obtains TLS.
stream-lumen.xybron.com {
    request_body {
        max_size 9MB
    }
    reverse_proxy 127.0.0.1:3480
    header Strict-Transport-Security "max-age=31536000"
    # Do not log publishing Authorization headers. No credentials in URLs.
}
