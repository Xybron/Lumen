# Relay service on the VPS. Generate a fresh secret; never commit a real token.
HOST=127.0.0.1
PORT=3480
LUMEN_WATCH_DATA_DIR=/var/lib/lumen-watch
LUMEN_WATCH_SLUGS=live
# Required: generate a unique token before starting. Blank fails safely.
LUMEN_WATCH_PUSH_TOKEN=

# Optional private production output. Keep a separate slug from public Watch.
# Add program to LUMEN_WATCH_SLUGS above before enabling these together.
# LUMEN_WATCH_PRIVATE_SLUGS=program
# Generate a different high-entropy viewer secret, not the publishing secret.
# LUMEN_WATCH_VIEWER_TOKEN=

# Private station environment (not the browser or public viewer):
# LUMEN_WATCH_RELAY_URL=https://stream-lumen.xybron.com
# LUMEN_WATCH_RELAY_SLUG=live
# LUMEN_WATCH_RELAY_TOKEN=the-same-private-push-token

# Multi-workspace deployment: explicit private registry, never browser supplied.
# When set, legacy unscoped streams and global credentials above are disabled.
# The service user must own this regular non-symlink file; use mode 600.
# LUMEN_WATCH_TENANTS_FILE=/etc/lumen-watch-tenants.json
# Each registered workspace uses its actual immutable team UUID and different
# generated publishing/viewer tokens. See tenants.example.json and README.
