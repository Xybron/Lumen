{
  "name": "lumen",
  "private": true,
  "version": "1.0.0",
  "description": "Lumen — a sleek, single-operator projection & presentation platform.",
  "scripts": {
    "desktop:install": "npm --prefix desktop ci",
    "desktop:prepare": "npm run build && npm --prefix desktop run prepare:bundle",
    "desktop:package": "npm run desktop:prepare && npm --prefix desktop run package",
    "desktop:package:dir": "npm run desktop:prepare && npm --prefix desktop run package:dir",
    "desktop:test": "node --test desktop/test/*.test.cjs",
    "desktop:smoke": "node desktop/scripts/smoke.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:watch": "node scripts/dev-watch.mjs",
    "dev:team": "node scripts/dev-team.mjs",
    "mobile:setup": "node scripts/mobile-local.mjs setup",
    "dev:mobile": "node scripts/mobile-local.mjs start",
    "test:mobile": "npm run build && node backend/test/mobile-controller-browser.mjs",
    "test:data-transfer": "npm run build && node backend/test/data-transfer-browser.mjs",
    "team:sync": "node scripts/team-sync.mjs",
    "test:team:browser": "node backend/test/team-browser.mjs",
    "test:team:real": "node backend/test/team-real-browser.mjs",
    "test:team:isolation": "npm run build && node backend/test/team-workspace-real-browser.mjs",
    "test:outputs": "npm run build && node backend/test/output-delivery-browser.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "start": "npm --prefix backend run start",
    "test": "npm --prefix backend test",
    "test:studio": "npm run build && npm --prefix backend run test:studio",
    "test:studio:capture": "npm run build && node backend/test/capture-card-browser.mjs",
    "test:studio:camera-formats": "npm run build && node backend/test/camera-formats-browser.mjs",
    "test:studio:source-properties": "npm run build && node backend/test/source-properties-browser.mjs",
    "test:studio:editing": "npm run build && npm --prefix backend run test:studio:editing",
    "test:studio:properties": "npm run build && node backend/test/studio-properties-browser.mjs",
    "test:clips": "npm run build && node backend/test/nle-browser.mjs",
    "test:clips:previews": "npm run build && node backend/test/timeline-previews-browser.mjs",
    "test:clips:transitions": "npm run build && node backend/test/nle-transitions-browser.mjs",
    "test:clips:delivery": "npm run build && node backend/test/clip-delivery-browser.mjs",
    "test:broadcast": "npm run build && node backend/test/broadcast-browser.mjs",
    "test:watch": "npm --prefix watch-relay test && npm --prefix backend run test:watch:browser",
    "test:watch:local": "npm run build && node backend/test/local-watch-browser.mjs",
    "test:studio:animation": "npm run build && npm --prefix backend run test:studio:animation",
    "test:studio:presets": "npm run build && npm --prefix backend run test:studio:presets",
    "test:workspaces": "npm run build && node backend/test/workspace-design-browser.mjs",
    "test:channels:layout": "npm run build && node backend/test/channel-height-browser.mjs",
    "test:scripture:doubleclick": "npm run build && node backend/test/scripture-doubleclick-browser.mjs",
    "test:scripture:search": "npm run build && node backend/test/scripture-search-browser.mjs",
    "test:scripture:focus": "npm run build && node backend/test/scripture-autofocus-browser.mjs",
    "test:lyrics:search": "npm run build && node backend/test/lyrics-search-browser.mjs",
    "test:presentation": "npm run build && node backend/test/presentation-design-browser.mjs",
    "test:channel-program": "npm run build && node backend/test/channel-program-browser.mjs",
    "test:channel-workflow": "npm run build && node backend/test/channel-workflow-browser.mjs",
    "test:studio:audio": "npm run build && node backend/test/main-audio-browser.mjs",
    "test:studio:audio:status": "npm run build && node backend/test/main-audio-status-browser.mjs",
    "test:studio:screen": "npm run build && node backend/test/screen-share-browser.mjs",
    "test:studio:shortcuts": "npm run build && node backend/test/scene-shortcuts-browser.mjs",
    "test:studio:multiview": "npm run build && node backend/test/multiview-browser.mjs",
    "test:studio:media": "npm run build && node backend/test/source-media-browser.mjs",
    "test:worship": "npm run build && node backend/test/worship-browser.mjs",
    "test:ai": "npm run build && node backend/test/worship-browser.mjs --ai",
    "test:ai:quality": "npm --prefix backend run test:ai:quality",
    "test:scripture:auto": "npm run build && node backend/test/scripture-auto-browser.mjs",
    "test:listening:input": "npm run build && node backend/test/listening-input-browser.mjs",
    "test:confirmations": "npm run build && node backend/test/confirmation-dialog-browser.mjs",
    "setup:ai": "node scripts/setup-listening.mjs",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install && npm --prefix watch-relay install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
