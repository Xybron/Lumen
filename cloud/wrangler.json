{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen-cloud-local",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "lumen-cloud-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_ENV": "staging",
        "SUPABASE_URL": "https://xfppsgiothkvhndmbixx.supabase.co",
        "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173"
      }
    },
    "production": {
      "name": "lumen-cloud",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_ENV": "production",
        "SUPABASE_URL": "",
        "ALLOWED_ORIGINS": ""
      }
    }
  }
}
